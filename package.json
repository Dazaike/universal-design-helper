{
  "name": "universal-design-helper",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp:start": "node mcp-server/dist/index.js",
    "mcp:shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-mcp-shortcut.ps1",
    "mcp:autostart": "powershell -ExecutionPolicy Bypass -File scripts/create-mcp-shortcut.ps1 -Location Startup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.322",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
